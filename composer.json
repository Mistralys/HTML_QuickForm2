{
    "name":        "mistralys/html_quickform2",
    "description": "Provides methods to create, validate and render HTML forms in PHP.",
    "type":        "library",
    "keywords":    ["forms", "validation", "javascript", "wizard", "quickform"],
    "homepage":    "https://github.com/Mistralys/HTML_QuickForm2",
    "license":     "BSD-3-Clause",
    "authors": [
        {
            "email": "avb@php.net",
            "name": "Alexey Borzov",
            "role": "Lead"
        },
        {
            "email": "golgote@mamasam.com",
            "name": "Bertrand Mansion",
            "role": "Lead"
        },
        {
            "email": "s.mordziol@mistralys.eu",
            "name": "Sebastian Mordziol",
            "role": "Lead"
        }
    ],
    "support": {
        "issues": "https://github.com/Mistralys/HTML_QuickForm2/issues",
        "source": "https://github.com/Mistralys/HTML_QuickForm2",
        "docs":   "https://pear.php.net/manual/en/package.html.html-quickform2.php"
    },
    "require": {
        "symfony/polyfill-php80": ">=v1.27.0",
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "classmap": [
            "HTML"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/QuickFormTests/CustomClasses",
            "tests/QuickFormTests/CaseClasses"
        ]
    },
    "scripts": {
        "analyze": "php vendor/bin/phpstan analyse --configuration phpstan.neon --memory-limit=900M",
        "analyze-save": "php vendor/bin/phpstan analyse --configuration phpstan.neon --memory-limit=900M > phpstan-result.txt || true",
        "analyze-clear": "php vendor/bin/phpstan clear-result-cache",
        "test": "php vendor/bin/phpunit",
        "test-file": "php vendor/bin/phpunit",
        "test-suite": "php vendor/bin/phpunit --testsuite",
        "test-filter": "php vendor/bin/phpunit --filter",
        "test-group": "php vendor/bin/phpunit --group"
    }
}
